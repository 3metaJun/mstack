{
  "codex": {
    "directoryVariable": "HARNESS_SKILLS_CODEX_DIR",
    "fallback": [".agents", "skills"],
    "skills": {
      "install": "own",
      "discovers": ["own"]
    },
    "runtime": {
      "command": "codex",
      "headlessArgs": ["exec", "--sandbox", "read-only"],
      "modelArgs": ["--model", "{model}"],
      "readOnlyArgs": []
    }
  },
  "claude": {
    "directoryVariable": "HARNESS_SKILLS_CLAUDE_DIR",
    "configVariable": "CLAUDE_CONFIG_DIR",
    "configFallback": ".claude",
    "suffix": ["skills"],
    "skills": {
      "install": "own",
      "discovers": ["own"]
    },
    "runtime": {
      "command": "claude",
      "headlessArgs": ["--print", "--no-session-persistence", "--output-format", "text"],
      "modelArgs": ["--model", "{model}"],
      "readOnlyArgs": ["--tools", "Read,Glob,Grep"]
    }
  },
  "opencode": {
    "directoryVariable": "HARNESS_SKILLS_OPENCODE_DIR",
    "configVariable": "XDG_CONFIG_HOME",
    "configFallback": ".config",
    "prefix": ["opencode"],
    "suffix": ["skills"],
    "skills": {
      "install": "codex",
      "discovers": ["own", "codex", "claude"],
      "legacy": "own"
    },
    "runtime": {
      "command": "opencode",
      "headlessArgs": ["run", "--pure"],
      "modelArgs": ["--model", "{model}"],
      "readOnlyArgs": ["--agent", "plan"]
    }
  },
  "pi": {
    "directoryVariable": "HARNESS_SKILLS_PI_DIR",
    "configVariable": "PI_CODING_AGENT_DIR",
    "configFallback": ".pi/agent",
    "suffix": ["skills"],
    "skills": {
      "install": "codex",
      "discovers": ["own", "codex"],
      "legacy": "own"
    },
    "runtime": {
      "command": "pi",
      "headlessArgs": ["-p", "--no-session"],
      "modelArgs": ["--model", "{model}"],
      "readOnlyArgs": ["--tools", "read,grep,find,ls"]
    }
  }
}
